# Cấu hình Server
PORT=5000
NODE_ENV=development

# Cấu hình MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=coffee_shop

# JWT
JWT_SECRET=coffee_shop_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Set only to the exact number of trusted reverse proxies in production.
# TRUST_PROXY_HOPS=1

# URL frontend (dùng cho CORS)
CLIENT_URL=http://localhost:5173
